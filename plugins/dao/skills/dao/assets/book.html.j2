{#- The book: one organization on one page, for a person to read.

    `dao book` fills this from the six documents. The page it makes runs no script and loads
    nothing: the policy in the first <meta> forbids both, so what a document contains can be
    shown and never run. Everything the page needs is in this file.

    Context: `book` (dao.domain.book.Book), `version`, `kinds` (participant name -> kind),
    and the filters `md` (a document's Markdown), `mdi` (one line of it) and `slug`.
-#}
{%- set front = book.document("front-door") -%}
{%- set rules = [book.document("constitution"), book.document("policies"), book.document("principles")] -%}
{%- macro kind_of(k) -%}
  {%- if k == "human" -%}person{%- elif k == "agent" -%}agent{%- else -%}not stated{%- endif -%}
{%- endmacro -%}
{%- macro holder(name) -%}
  <span class="who who-{{ kinds.get(name) or 'unknown' }}">{{ name }}<span class="kind">{{ kind_of(kinds.get(name)) }}</span></span>
{%- endmacro -%}
{%- macro rule(doc) %}
  <section class="rule" id="{{ doc.key }}" aria-labelledby="{{ doc.key }}-title">
    <header class="section-head">
      <h2 id="{{ doc.key }}-title">{{ doc.name }}</h2>
      <a class="source" href="{{ doc.file }}">{{ doc.file }}</a>
    </header>
    <p class="dek">{{ doc.summary }}</p>
    {% if doc.markdown %}
    <div class="prose">
{{ doc.markdown | md }}
    </div>
    {% else %}
    <p class="empty">Not written yet.</p>
    {% endif %}
  </section>
{% endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="dao {{ version }}">
<meta name="dao-sources" content="{{ book.sources }}">
<title>{{ book.title }}</title>
<style>
  :root {
    color-scheme: light dark;
    --paper: #f5f7f3;
    --surface: #ffffff;
    --ink: #17211d;
    --muted: #55645e;
    --line: #d7ded8;
    --accent: #1b6b58;
    --accent-soft: #e2efe9;
    --warn: #8a5200;
    --warn-soft: #fbf1dc;
    --read: Charter, "Bitstream Charter", "Sitka Text", Cambria, Georgia, serif;
    --ui: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0f1513;
      --surface: #161e1b;
      --ink: #e3eae6;
      --muted: #97a8a1;
      --line: #2a3632;
      --accent: #77cfb5;
      --accent-soft: #1a2c26;
      --warn: #e4b563;
      --warn-soft: #2d2614;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { font-size: 106.25%; -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--read);
    line-height: 1.6;
  }
  .page { max-width: 46rem; margin: 0 auto; padding: 3.5rem 1rem 5rem; }
  a { color: var(--accent); text-underline-offset: 0.18em; text-decoration-thickness: 0.06em; }
  a:hover { text-decoration-thickness: 0.12em; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
  .skip { position: absolute; left: -100rem; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--surface); padding: 0.4rem 0.7rem; }

  h1, h2, h3, h4, h5, h6 { line-height: 1.2; text-wrap: balance; margin: 0; font-weight: 700; }
  h1 { font-size: clamp(2.1rem, 6vw, 3rem); letter-spacing: -0.015em; }
  h2 { font-size: 1.6rem; letter-spacing: -0.01em; }
  h3 { font-size: 1.15rem; }
  h4, h5, h6 { font-size: 1rem; }
  code, pre { font-family: var(--mono); font-size: 0.86em; }
  code { background: var(--accent-soft); padding: 0.08em 0.32em; border-radius: 3px; }

  .label {
    font-family: var(--ui); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); margin: 0;
  }

  /* Masthead */
  .mast { padding-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
  .mast h1 { margin: 0.7rem 0 1.4rem; }
  .contents { margin: 2rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem;
    font-family: var(--ui); font-size: 0.9rem; }

  /* Sections */
  main > section { padding-top: 3.25rem; }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 1rem; }
  .source { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  .dek { color: var(--muted); margin: 0.5rem 0 1.5rem; max-width: 38rem; }
  .empty { color: var(--muted); font-style: italic; }

  /* A document's own text */
  .prose > :first-child { margin-top: 0; }
  .prose > :last-child { margin-bottom: 0; }
  .prose p, .prose ul, .prose ol, .prose blockquote, .prose pre, .prose .table { margin: 0 0 1rem; }
  .prose h3 { margin: 2rem 0 0.6rem; }
  .prose h4, .prose h5, .prose h6 { margin: 1.5rem 0 0.5rem; }
  .prose ul, .prose ol { padding-left: 1.3rem; }
  .prose li { margin: 0.3rem 0; }
  .prose li::marker { color: var(--muted); }
  .prose blockquote { margin-left: 0; padding-left: 1rem; border-left: 2px solid var(--line); color: var(--muted); }
  .prose pre { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 0.8rem 1rem; overflow-x: auto; }
  .prose pre code { background: none; padding: 0; }
  .prose img { max-width: 100%; height: auto; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
  .table { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.55rem 0.9rem 0.55rem 0; border-bottom: 1px solid var(--line); }
  th { font-family: var(--ui); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); }

  /* People and agents: the mark differs in shape as well as in word */
  .who { white-space: nowrap; font-weight: 700; }
  .who::before { content: ""; display: inline-block; width: 0.55em; height: 0.55em; margin-right: 0.4em;
    border: 0.12em solid var(--accent); transform: translateY(-0.04em); }
  .who-human::before { border-radius: 50%; background: var(--accent); }
  .who-agent::before { transform: translateY(-0.04em) rotate(45deg); }
  .who-unknown::before { border-style: dotted; }
  .kind { font-family: var(--ui); font-size: 0.72rem; font-weight: 500; color: var(--muted); margin-left: 0.45em; }

  /* The chains of checking */
  .chains { margin: 0 0 2rem; padding: 1.1rem 1.2rem; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  .chains ol { list-style: none; margin: 0.8rem 0 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .chains ol + ol { margin-top: 0.6rem; }
  .chains li { display: flex; align-items: center; gap: 0.5rem; }
  .chains li + li::before { content: "read by \2192"; font-family: var(--ui); font-size: 0.78rem; color: var(--muted); }
  .chains a { display: inline-block; padding: 0.2rem 0.7rem; border: 1px solid var(--accent); border-radius: 999px;
    font-family: var(--ui); font-size: 0.9rem; font-weight: 600; text-decoration: none; }
  .chains a:hover { background: var(--accent-soft); }
  .chains .ends { font-family: var(--ui); font-size: 0.78rem; color: var(--muted); }

  /* Positions */
  .positions { display: grid; gap: 1rem; }
  .position { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 1.3rem 1.4rem 1.4rem; scroll-margin-top: 1rem; }
  .position h3 { font-size: 1.3rem; }
  .position .held { margin: 0.45rem 0 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; font-size: 0.95rem; }
  .position dl { margin: 1.1rem 0 0; display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.8rem 1rem; }
  .position dt { padding-top: 0.28rem; }
  .position dd { margin: 0; }
  @media (max-width: 34rem) {
    .position dl { grid-template-columns: 1fr; gap: 0.2rem; }
    .position dd { margin-bottom: 0.7rem; }
  }

  /* What dao check found, when it found something */
  .gaps { margin-top: 2.5rem; padding: 1.1rem 1.3rem; background: var(--warn-soft); border: 1px solid var(--warn); border-radius: 8px; }
  .gaps h2 { font-size: 1.1rem; color: var(--warn); }
  .gaps ul { margin: 0.7rem 0 0; padding-left: 1.2rem; }
  .gaps li { margin: 0.3rem 0; }

  footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
    font-family: var(--ui); font-size: 0.8rem; color: var(--muted); }
  footer p { margin: 0 0 0.5rem; max-width: 38rem; }
  footer code { background: none; padding: 0; overflow-wrap: anywhere; }

  @media print {
    body { background: #fff; color: #000; }
    .page { max-width: none; padding: 0; }
    .skip, .contents { display: none; }
    a { color: inherit; text-decoration: none; }
    .position, .chains { break-inside: avoid; }
  }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to the organization</a>
<div class="page">
  <header class="mast" id="top">
    <p class="label">A directed agent organization</p>
    <h1>{{ book.title }}</h1>
    {% if front.markdown %}
    <div class="prose">
{{ front.markdown | md }}
    </div>
    {% endif %}
    <nav aria-label="On this page">
      <ul class="contents">
        <li><a href="#constitution">Constitution</a></li>
        <li><a href="#positions">Positions</a></li>
        <li><a href="#participants">Participants</a></li>
        <li><a href="#policies">Governing policies</a></li>
        <li><a href="#principles">Operating principles</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    {% if not book.complete %}
    <aside class="gaps" aria-labelledby="gaps-title">
      <h2 id="gaps-title">This organization is not complete</h2>
      <p>When this page was made, <code>dao check</code> found:</p>
      <ul>
        {% for doc in book.documents if doc.status != "PRESENT" %}
        {% for gap in doc.gaps %}
        <li><strong>{{ doc.name }}.</strong> {{ gap }}</li>
        {% endfor %}
        {% endfor %}
      </ul>
    </aside>
    {% endif %}
{{ rule(rules[0]) }}
    <section id="positions" aria-labelledby="positions-title">
      {% set doc = book.document("positions") %}
      <header class="section-head">
        <h2 id="positions-title">{{ doc.name }}</h2>
        <a class="source" href="{{ doc.file }}">{{ doc.file }}</a>
      </header>
      <p class="dek">{{ doc.summary }}</p>
      {% if book.chains %}
      <div class="chains">
        <p class="label">Whose work is read by whom</p>
        {% for chain in book.chains %}
        <ol>
          {% for name in chain %}
          <li><a href="#position-{{ name | slug }}">{{ name }}</a></li>
          {% endfor %}
        </ol>
        {% endfor %}
      </div>
      {% endif %}
      {% if book.positions %}
      <div class="positions">
        {% for p in book.positions %}
        <article class="position" id="position-{{ p.name | slug }}">
          <h3>{{ p.name }}</h3>
          <p class="held">
            {% for name in p.held_by %}
            {{ holder(name) }}
            {% else %}
            <span class="empty">Nobody holds this position.</span>
            {% endfor %}
          </p>
          <dl>
            <dt class="label">Does</dt>
            <dd>{% if p.does %}{{ p.does | mdi }}{% else %}<span class="empty">Not written.</span>{% endif %}</dd>
            <dt class="label">Must not</dt>
            <dd>{% if p.must_not %}{{ p.must_not | mdi }}{% else %}<span class="empty">Not written.</span>{% endif %}</dd>
            <dt class="label">Checked by</dt>
            <dd>
              {%- if p.checked_by -%}
                {%- for name in p.checked_by -%}
                  <a href="#position-{{ name | slug }}">{{ name }}</a>{{ ", " if not loop.last }}
                {%- endfor -%}
              {%- elif p.held_only_by_people -%}
                Nobody. A person holds this position, and accountability ends with them.
              {%- else -%}
                <span class="empty">Nobody.</span>
              {%- endif -%}
            </dd>
            {% if p.checks %}
            <dt class="label">Reads</dt>
            <dd>the work of {% for name in p.checks %}<a href="#position-{{ name | slug }}">{{ name }}</a>{{ ", " if not loop.last }}{% endfor %}</dd>
            {% endif %}
          </dl>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="empty">No positions are written yet.</p>
      {% endif %}
    </section>

    <section id="participants" aria-labelledby="participants-title">
      {% set doc = book.document("participants") %}
      <header class="section-head">
        <h2 id="participants-title">{{ doc.name }}</h2>
        <a class="source" href="{{ doc.file }}">{{ doc.file }}</a>
      </header>
      <p class="dek">{{ doc.summary }}</p>
      {% if book.participants %}
      <div class="table">
        <table>
          <thead>
            <tr><th scope="col">Participant</th><th scope="col">Holds</th><th scope="col">Defined in</th></tr>
          </thead>
          <tbody>
            {% for who in book.participants %}
            <tr>
              <td>{{ holder(who.name) }}</td>
              <td>
                {%- for name in who.positions -%}
                  <a href="#position-{{ name | slug }}">{{ name }}</a>{{ ", " if not loop.last }}
                {%- else -%}
                  <span class="empty">no position</span>
                {%- endfor -%}
              </td>
              <td>{% if who.defined_in %}<code>{{ who.defined_in }}</code>{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <p class="empty">No participants are written yet.</p>
      {% endif %}
    </section>
{{ rule(rules[1]) }}
{{ rule(rules[2]) }}
  </main>

  <footer>
    <p>
      This page is a copy for reading. The source is the six Markdown documents in
      <code>{{ book.directory }}/</code>, and their history is the record of how each rule came to be.
    </p>
    <p>
      Made by dao {{ version }}.
      {% if book.complete %}
      When it was made, <code>dao check</code> found all six documents present. That is a check
      of form, not a review of what they say.
      {% else %}
      When it was made, <code>dao check</code> found the gaps listed at the top.
      {% endif %}
      The page runs no script and loads nothing from the network.
    </p>
    <p>Sources: <code>{{ book.sources }}</code></p>
  </footer>
</div>
</body>
</html>
