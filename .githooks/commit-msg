#!/usr/bin/env python3
"""Validate conventional commit format. Mirrors the CI commit-lint job.

Lifted from cix; gnx wires it via core.hooksPath so it actually runs.
"""

import re
import sys

PATTERN = re.compile(
    r"^(feat|fix|docs|refactor|test|chore|perf|ci|build|style|revert)(\(.+\))?\!?: .+"
)

with open(sys.argv[1]) as f:
    msg = f.readline().strip()

if msg.startswith("Merge "):
    sys.exit(0)

if not PATTERN.match(msg):
    print(f"\n❌ Invalid commit message: {msg}")
    print()
    print("  Must follow: <type>(<scope>): <description>")
    print("  Types: feat, fix, docs, refactor, test, chore, perf, ci, build, style, revert")
    print()
    sys.exit(1)
