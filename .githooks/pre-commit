#!/bin/sh
# Pre-commit gate. The justfile is the single source of truth — this hook only
# delegates, so it cannot drift from CI. Wired by `git config core.hooksPath
# .githooks` (see CONTRIBUTING.md). cix shipped this file but never wired it;
# gnx wires it.

if command -v just >/dev/null 2>&1; then
    just check
else
    echo "⚠ just not found — running the docsite check directly."
    echo "  Install just (https://just.systems) for the full gate (incl. secret scan)."
    ( cd docs/experience && bun run check )
fi
